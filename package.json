{
	"name": "code-generator-v2",
	"version": "1.0.0",
	"description": "Generador de código TS",
	"author": {
		"name": "Roberto Sáez Margotta",
		"email": "margotta@gmail.com",
		"url": "https://www.margotta.cl"
	},
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"bin": "./dist/index.js",
	"scripts": {
		"start": "tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"watch": "tsx watch --include \"src/**/*.ejs\" src/index.ts"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.17.0",
			"onFail": "download"
		}
	},
	"dependencies": {
		"@opentui/core": "^0.4.5",
		"ejs": "^6.0.1",
		"ora": "^9.4.1",
		"pg": "^8.22.0",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.10.0",
		"typeorm": "^1.1.0",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@types/ejs": "^3.1.5",
		"@types/node": "^26.1.2",
		"@types/yargs": "^17.0.35",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}