<%-Imports.trim()%>

export class <%-Model.ClassName%>Params implements I<%-Model.ClassName%>Params {
<%
	Model.Key.Properties.forEach((property, index) => {
%>	@ApiProperty({ name: '<%-property.PropertyName%>' })
	@Expose({ name: '<%-property.PropertyName%>' })
<%
%>	@IsNotEmpty()
<%
			if (property.PropertyType === 'number')
			{
%>	@IsNumber()
<%
			}

			if (property.PropertyType === 'boolean')
			{
%>	@IsBoolean()
<%
			}

			if (property.PropertyType === 'date')
			{
%>	@IsDate()
<%
			}

			if (property.PropertyType === 'string' && property.UdtType === 'uuid')
			{
%>	@IsUUID()
<%
			}

			if (property.PropertyType === 'string' && property.UdtType === 'varchar')
			{
%>	@IsString()
<%
			}

%>	<%-property.PropertyName%><%- property.Nullable ? '?': '' %>: <%-property.PropertyType%>
<%

			if (index !== Model.Key.Properties.length -1) 
			{
%>
<%
			}

	})
%>}