<%-Imports.trim()%>

@Injectable()
export class <%-Model.ClassName%>Repository {
<%
	if (Model.ReadOnly) {
%>	constructor(@InjectRepository(<%-Model.ClassName%>Model) private repository: Repository<<%-Model.ClassName%>Model>) { }
<%

	}
	else {
%>	constructor(@InjectRepository(<%-Model.ClassName%>Model) private repository: Repository<<%-Model.ClassName%>Model>, private readonly eventEmitter: EventEmitter2) { }
<%
	}
%>
	public Get = async (key: I<%-Model.ClassName%>Key): Promise<I<%-Model.ClassName%>Model | null> => await this.repository.findOne({
		where: plainToInstance(<%-Model.ClassName%>Key, key, { excludeExtraneousValues: true, enableImplicitConversion: true })
	})

	public Find = async (query: I<%-Model.ClassName%>Query): Promise<I<%-Model.ClassName%>Model[]> => await this.repository.find({ where: await this.where(query) })

	public Exists = async (query: I<%-Model.ClassName%>Query): Promise<boolean> => await this.repository.exists({ where: await this.where(query) })
<%
	if (!Model.ReadOnly) {
%>
	public Create = async (value: I<%-Model.ClassName%>Value): Promise<I<%-Model.ClassName%>Model> => {
		const created: I<%-Model.ClassName%>Model = await this.repository.save(value)

		this.eventEmitter.emit(<%-Model.ClassName%>Events.OnCreated, created)

		return created
	}

	public Update = async (key: I<%-Model.ClassName%>Key, value: Partial<I<%-Model.ClassName%>Value>): Promise<I<%-Model.ClassName%>Model | null> => {
		const primaryKey: I<%-Model.ClassName%>Key = plainToInstance(<%-Model.ClassName%>Key, key, { excludeExtraneousValues: true, enableImplicitConversion: true })

		const previous: I<%-Model.ClassName%>Model = await this.repository.findOne({ where: primaryKey })

		if (!previous) return null

		const updated: I<%-Model.ClassName%>Model = await this.repository.save({ ...primaryKey, ...value })

		this.eventEmitter.emit(<%-Model.ClassName%>Events.OnUpdated, previous, updated)

		return updated
	}

	public Remove = async (key: I<%-Model.ClassName%>Key): Promise<I<%-Model.ClassName%>Model | null> => {
		const removed: I<%-Model.ClassName%>Model = await this.repository.findOne({ where: plainToInstance(<%-Model.ClassName%>Key, key, { excludeExtraneousValues: true, enableImplicitConversion: true }) })

		if (!removed) return null

		await this.repository.delete(plainToInstance(<%-Model.ClassName%>Key, key, { excludeExtraneousValues: true, enableImplicitConversion: true }))

		this.eventEmitter.emit(<%-Model.ClassName%>Events.OnRemoved, removed)

		return removed
	}
<%
	}
%>
	private where = async (_query: I<%-Model.ClassName%>Query): Promise<FindOptionsWhere<I<%-Model.ClassName%>Model>> => {
		const where: FindOptionsWhere<I<%-Model.ClassName%>Model> = {}

		return where
	}
}