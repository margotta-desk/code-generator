<%-Imports.trim()%>

export class <%-Model.ClassName%>Response implements I<%-Model.ClassName%>Response {<%
	if (Model.OneToOne.length !== 0)
	{
%>
	//	One to One
<%
		Model.OneToOne.forEach((reference, index) => {
%>	@ApiPropertyOptional({ name: '<%-reference.Class.ClassName%>' })
	@Expose({ name: '<%-reference.Class.ClassName%>', toClassOnly: true })
	@Type(() => <%-reference.Class.ClassName%>Response)
	<%-reference.DependencyName%>?: I<%-reference.Class.ClassName%>Response
<%
			if (index + 1 != Model.OneToOne.length)
			{
%>
<%
			}
		})
	}


	if (Model.ManyToOne.length !== 0)
	{
%>
	//	Many to One
<%
		Model.ManyToOne.forEach((reference, index) => {
%>	@ApiPropertyOptional({ name: '<%-reference.Class.ClassName%>' })
	@Expose({ name: '<%-reference.Class.ClassName%>', toClassOnly: true })
	@Type(() => <%-reference.Class.ClassName%>Response)
	<%-reference.DependencyName%>?: I<%-reference.Class.ClassName%>Response
<%
			if (index + 1 != Model.ManyToOne.length)
			{
%>
<%
			}
		})
	}

	if (Model.Properties.length !== 0)
	{
%>
	//	Properties
<%
		Model.Properties.forEach((property, index) => {
%>	@ApiProperty<%property.Nullable ? 'Optional' : '' %>({ name: '<%-property.PropertyName%>'<%
			if (property.PropertyType === 'Date' && property.UdtType === 'date') { %>, type: String, format: 'date'<% }
			if (property.PropertyType === 'Date' && property.UdtType === 'timestamp') { %>, type: String, format: 'date-time'<% }
%> })
	@Expose({ name: '<%-property.PropertyName%>' })
	<%-property.PropertyName%><%- property.Nullable ? '?': '' %>: <%-property.PropertyType%>
<%
			if (index + 1 != Model.Properties.length)
			{
%>
<%
			}
		})
	}
%>}