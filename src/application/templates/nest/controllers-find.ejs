	@Get()
	async Find(@Query() query: <%-Model.ClassName%>Query): Promise<I<%-Model.ClassName%>Response[]> {
		return plainToInstance(<%-Model.ClassName%>Response,
			await this.<%-Model.FieldName%>Service.Find(plainToInstance(<%-Model.ClassName%>Query, query, { excludeExtraneousValues: true, enableImplicitConversion: true })),
			{ excludeExtraneousValues: true, enableImplicitConversion: true }
		)
	}